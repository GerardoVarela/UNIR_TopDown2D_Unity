      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: dialogues.Array.data[2].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[0].lines.Array.data[0]'
      value: "\xA1No puedo salir de esta cueva! Ay\xFAdame..."
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[0].lines.Array.data[1]'
      value: Unos orcos la invadieron y no dejan avanzar...
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[0].lines.Array.data[2]'
      value: Tengo la llave de la puerta...
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[0].lines.Array.data[3]'
      value: "Tr\xE1eme 3 esqueletos de orco y te dar\xE9 la llave."
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[1].lines.Array.data[0]'
      value: "\xA1Wow! Realmente eres muy h\xE1bil..."
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[1].lines.Array.data[1]'
      value: "Aqu\xED tienes la llave de la puerta..."
      objectReference: {fileID: 0}
    - target: {fileID: 9154946001312572491, guid: 9a739f3767a46194cbdd0c95311ad6b0, type: 3}
      propertyPath: 'dialogues.Array.data[1].lines.Array.data[2]'
